@model CapaDatos.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-eyeglasses"></i> Registrar Nuevo Producto</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre del Producto</label>
                        <input asp-for="Nombre" class="form-control" required autocomplete="off" placeholder="Ingrese el nombre" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría</label>
                        <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias" required>
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Precio" class="form-label fw-semibold">Precio</label>
                        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" required placeholder="0.00" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold">Stock</label>
                        <input asp-for="Stock" type="number" min="0" class="form-control" required placeholder="0" />
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del producto (opcional)"></textarea>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg"></i> Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>