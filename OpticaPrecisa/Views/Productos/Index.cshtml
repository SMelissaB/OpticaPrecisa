@model IEnumerable<CapaDatos.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-eyeglasses" aria-hidden="true"></i> Lista de Productos</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Producto
        </a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Ok"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">Listado de productos registrados</caption>
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="d-none d-md-table-cell">ID</th>
                            <th scope="col">Nombre</th>
                            <th scope="col" class="d-none d-md-table-cell">Categoría</th>
                            <th scope="col">Precio</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end text-nowrap">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="d-none d-md-table-cell">@item.IdProducto</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="d-none d-md-table-cell">@(item.IdCategoriaNavigation?.Nombre ?? "Sin categoría")</td>
                                <td>S/ @item.Precio.ToString("0.00")</td>
                                <td>@item.Stock</td>
                                <td>
                                    @if (item.Estado == true)
                                    {
                                        <span class="text-success fw-bold">● Activo</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">● Inactivo</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Detalle" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-secondary me-1"
                                       title="Ver detalle" aria-label="Ver detalle de @item.Nombre">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-warning me-1"
                                       title="Editar" aria-label="Editar @item.Nombre">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@item.IdProducto" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Estás seguro de dar de baja este producto?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="Dar de baja" aria-label="Dar de baja @item.Nombre">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>