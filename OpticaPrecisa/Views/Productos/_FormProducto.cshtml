@model OpticaPrecisa.Models.ProductoViewModel

<input type="hidden" asp-for="IdProducto" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label fw-semibold"></label>
        <input asp-for="Nombre" class="form-control" autocomplete="off" placeholder="Ingrese el nombre" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="IdCategoria" class="form-label fw-semibold"></label>
        <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">-- Seleccione una categoría --</option>
        </select>
        <span asp-validation-for="IdCategoria" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Precio" class="form-label fw-semibold"></label>
        <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label fw-semibold"></label>
        <input asp-for="Stock" type="number" class="form-control" placeholder="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    @if (Model.IdProducto > 0)
    {
        <div class="col-md-6 mb-3">
            <label asp-for="Estado" class="form-label fw-semibold"></label>
            <select asp-for="Estado" class="form-select">
                <option value="True">Activo</option>
                <option value="False">Inactivo</option>
            </select>
        </div>
    }

    <div class="col-12 mb-3">
        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del producto (opcional)"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
</div>
@{
}
