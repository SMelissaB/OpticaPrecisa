@model OpticaPrecisa.Models.ProductoViewModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-pencil-square" aria-hidden="true"></i> Editar Producto</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a la lista
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Editar" asp-route-id="@Model.IdProducto" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <partial name="_FormProducto" model="Model" />

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save" aria-hidden="true"></i> Actualizar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}