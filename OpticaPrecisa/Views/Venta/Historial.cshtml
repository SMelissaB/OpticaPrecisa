@model IEnumerable<CapaDatos.Venta>

@{
    ViewData["Title"] = "Historial de Ventas";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Historial de Ventas</h3>
        <a asp-action="Index" class="btn btn-primary">Nueva Venta</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>N° Venta</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Vendedor</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdVenta</td>
                <td>@(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                <td>@(item.IdClienteNavigation?.Nombre ?? $"Cliente #{item.IdCliente}")</td>
                <td>@(item.IdVendedorNavigation?.Nombre ?? $"Vendedor #{item.IdVendedor}")</td>
                <td>S/ @item.Total.ToString("F2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>