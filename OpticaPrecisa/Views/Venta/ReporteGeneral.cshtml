@model IEnumerable<CapaDatos.Venta>
@{
    ViewData["Title"] = "Reporte de Ventas";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-0 fw-bold">Reporte General de Ventas</h3>
            <p class="text-muted mb-0">Óptica Precisa | Generación de PDF desde Servidor</p>
        </div>
        <div>
            <!-- Botón que descarga el PDF real generado por el backend -->
            <a asp-action="ReporteGeneralPdf" 
               asp-route-fechaInicio="@ViewBag.FechaInicio" 
               asp-route-fechaFin="@ViewBag.FechaFin" 
               class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf"></i> Descargar Reporte PDF
            </a>
        </div>
    </div>

    <!-- Formulario de Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="ReporteGeneral" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Fecha Inicio</label>
                    <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Fecha Fin</label>
                    <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-filter"></i> Filtrar Vista
                    </button>
                    <a asp-action="ReporteGeneral" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>N° Venta</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Vendedor</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var v in Model)
                        {
                            <tr>
                                <td>@v.IdVenta.ToString("D6")</td>
                                <td>@(v.Fecha?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td>@v.IdClienteNavigation?.Nombre</td>
                                <td>@v.IdVendedorNavigation?.Nombre</td>
                                <td class="text-end">S/ @v.Total.ToString("0.00")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No se encontraron registros en el rango de fechas seleccionado.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td colspan="4" class="text-end">TOTAL RECAUDADO:</td>
                        <td class="text-end text-success">S/ @(Model != null ? Model.Sum(x => x.Total).ToString("0.00") : "0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>