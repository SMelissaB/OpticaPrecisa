@{
    Layout = null;
    ViewData["Title"] = "Recuperar Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpticaPrecisa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-sm p-4" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">OpticaPrecisa 👓</h2>
            <p class="text-muted">Recuperación de acceso</p>
        </div>

        <form asp-controller="Acceso" asp-action="ProcesarOlvideContrasena" method="post">
            <div class="mb-3">
                <label for="correo" class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" id="correo" name="correo" required autocomplete="off" placeholder="ejemplo@correo.com" />
            </div>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-success py-2 text-center" role="alert">
                    @ViewData["Mensaje"]
                </div>
            }

            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger py-2 text-center" role="alert">
                    @ViewData["Error"]
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Enviar Nueva Contraseña</button>

            <div class="text-center">
                <a asp-controller="Acceso" asp-action="Login" class="text-decoration-none small text-secondary">← Volver al inicio de sesión</a>
            </div>
        </form>
    </div>

</body>
</html>