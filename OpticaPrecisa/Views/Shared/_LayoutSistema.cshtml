<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpticaPrecisa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #1e293b;
        }

        body {
            min-height: 100vh;
            background-color: #f1f5f9;
            overflow-x: hidden;
        }

        .sidebar {
            width: var(--sidebar-width);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
            padding-top: 20px;
            background-color: var(--sidebar-bg);
            transition: transform 0.3s ease-in-out;
        }

            .sidebar .brand-container {
                padding: 10px 20px 20px 20px;
            }

            .sidebar .nav-link {
                font-weight: 500;
                color: #94a3b8;
                padding: 12px 20px;
                border-radius: 8px;
                margin: 4px 12px;
                transition: all 0.2s ease;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: #ffffff;
                    background-color: rgba(255, 255, 255, 0.08);
                }

                .sidebar .nav-link i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                }

        .navbar-top {
            background-color: #ffffff;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            height: 60px;
        }

        main {
            padding: 30px;
            transition: margin-left 0.3s ease-in-out;
        }

        @@media (min-width: 992px) {
            main

        {
            margin-left: var(--sidebar-width);
            padding-top: 90px;
        }

        .navbar-top {
            margin-left: var(--sidebar-width);
        }

        }

        @@media (max-width: 991.98px) {
            .sidebar

        {
            transform: translateX(-100%);
        }

        .sidebar.show {
            transform: translateX(0);
        }

        main {
            margin-left: 0;
            padding: 20px;
            padding-top: 80px;
        }

        .navbar-top {
            margin-left: 0;
        }

        }

        .card-table {
            border: none;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border-radius: 12px;
            background: #ffffff;
        }
    </style>
</head>
<body>

    <!-- Barra Superior -->
    <nav class="navbar navbar-expand navbar-light navbar-top px-4 fixed-top">
        <div class="container-fluid justify-content-between justify-content-lg-end">
            <button class="btn btn-outline-light text-dark d-lg-none border-0" type="button" id="sidebarToggle">
                <i class="bi bi-list fs-4"></i>
            </button>
            <ul class="navbar-nav align-items-center">
                <li class="nav-item me-3">
                    <span class="text-muted small">Usuario: <b class="text-dark">@User.Identity?.Name</b></span>
                </li>
                <li class="nav-item">
                    <a class="btn btn-light text-danger border btn-sm px-3 fw-semibold" asp-controller="Acceso" asp-action="Salir">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Menú Lateral (Sidebar) -->
    <div class="sidebar d-flex flex-column flex-shrink-0 text-white" id="appSidebar">
        <div class="brand-container d-flex align-items-center">
            <span class="fs-4 fw-bold text-white tracking-wide">OpticaPrecisa <span style="font-size: 1.2rem;">👓</span></span>
        </div>
        <hr class="border-secondary opacity-25 mx-3">
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Inicio
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Venta" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Ventas
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Productos" asp-action="Index">
                    <i class="bi bi-eyeglasses"></i> Productos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Clientes" asp-action="Index">
                    <i class="bi bi-people"></i> Clientes
                </a>
            </li>

            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item mt-4 mb-1">
                    <small class="text-muted px-4 text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05rem;">Administración</small>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Vendedor" asp-action="Index">
                        <i class="bi bi-person-badge"></i> Vendedor
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> Usuarios
                    </a>
                </li>
            }
        </ul>
    </div>

    <!-- Contenido Principal -->
    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('appSidebar');
        const toggleBtn = document.getElementById('sidebarToggle');

        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>