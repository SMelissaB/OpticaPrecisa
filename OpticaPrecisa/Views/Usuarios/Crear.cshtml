@model CapaDatos.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <!-- Cabecera de la sección -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-person-plus"></i> Registrar Nuevo Usuario</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <!-- Formulario con ancho equilibrado -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold">Nombre de Usuario</label>
                        <input asp-for="NombreUsuario" class="form-control" required autocomplete="off" placeholder="Ingrese el usuario" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Contrasena" class="form-label fw-semibold">Contraseña</label>
                        <input asp-for="Contrasena" type="password" class="form-control" required placeholder="Ingrese la contraseña" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" required placeholder="correo@ejemplo.com" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold">Rol del Sistema</label>
                        <select asp-for="Rol" class="form-select" required>
                            <option value="">-- Seleccione un rol --</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Vendedor">Vendedor</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg"></i> Guardar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>