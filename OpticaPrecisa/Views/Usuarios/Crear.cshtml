@model CapaDatos.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-plus"></i> Registrar Nuevo Usuario</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label fw-semibold">Nombre de Usuario</label>
                            <input asp-for="NombreUsuario" class="form-control" required autocomplete="off" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="Contrasena" type="password" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label fw-semibold">Rol del Sistema</label>
                            <select asp-for="Rol" class="form-select" required>
                                <option value="">-- Seleccione un rol --</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Vendedor">Vendedor</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Guardar Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>