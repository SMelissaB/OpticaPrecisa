@model CapaDatos.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <!-- Cabecera de la sección -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-pencil-square"></i> Editar Usuario</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <!-- Alertas de éxito o error para el cambio de contraseña u otras acciones -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Formulario con ancho equilibrado -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Editar" method="post">
                <!-- Campo oculto indispensable para conservar el ID al actualizar -->
                <input type="hidden" asp-for="IdUsuario" />

                <input type="hidden" asp-for="Contrasena" />

                <div class="row">
                    <!-- Nombre de usuario de solo lectura -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold">Nombre de Usuario</label>
                        <input asp-for="NombreUsuario" class="form-control bg-light" readonly />
                        <div class="form-text text-muted">El nombre de usuario no se puede modificar.</div>
                    </div>

                    <!-- Correo Electrónico (Editable) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" required />
                    </div>

                    <!-- Rol del Sistema (Editable) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold">Rol del Sistema</label>
                        <select asp-for="Rol" class="form-select" required>
                            <option value="Administrador">Administrador</option>
                            <option value="Vendedor">Vendedor</option>
                        </select>
                    </div>

                    <!-- Estado (Editable) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="True">Activo</option>
                            <option value="False">Inactivo</option>
                        </select>
                    </div>
                </div>

                <!-- Botón para abrir el Modal de Cambio de Contraseña -->
                <div class="mt-3">
                    <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalCambiarPassword">
                        <i class="bi bi-key"></i> Cambiar Contraseña
                    </button>
                </div>

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save"></i> Actualizar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Cambiar Contraseña -->
<div class="modal fade" id="modalCambiarPassword" tabindex="-1" aria-labelledby="modalCambiarPasswordLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CambiarPassword" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="modalCambiarPasswordLabel"><i class="bi bi-shield-lock"></i> Cambiar Contraseña</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="idUsuario" value="@Model.IdUsuario" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contraseña Actual</label>
                        <input type="password" name="passwordActual" class="form-control" required placeholder="Ingrese la contraseña actual" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nueva Contraseña</label>
                        <input type="password" name="nuevaPassword" class="form-control" required placeholder="Ingrese la nueva contraseña" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control" required placeholder="Repita la nueva contraseña" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Nueva Contraseña</button>
                </div>
            </form>
        </div>
    </div>
</div>