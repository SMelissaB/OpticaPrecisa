@model CapaDatos.Vendedor

@{
    ViewData["Title"] = "Registrar Vendedor";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
}

<div class="container-fluid px-4">
    <!-- Cabecera de la sección -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4 gap-2">
        <h2 class="text-secondary fw-bold fs-3 mb-0"><i class="bi bi-person-plus-fill"></i> Registrar Nuevo Vendedor</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <!-- Alertas de error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Formulario de Registro -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                <div class="row">
                    <!-- Relación con Usuario -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdUsuario" class="form-label fw-semibold">Usuario Asociado</label>
                        <select asp-for="IdUsuario" class="form-select" asp-items="ViewBag.ListaUsuarios" required>
                            <option value="">-- Seleccione un usuario --</option>
                        </select>
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>

                    <!-- Nombre del Vendedor -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre Completo</label>
                        <input asp-for="Nombre" class="form-control" required autocomplete="off" placeholder="Ingrese nombre completo" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- DNI -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Dni" class="form-label fw-semibold">DNI</label>
                        <input asp-for="Dni" class="form-control" required maxlength="8" placeholder="Ingrese DNI de 8 dígitos" />
                        <span asp-validation-for="Dni" class="text-danger"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ingrese teléfono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <!-- Correo Electrónico -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <!-- Fecha de Ingreso -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaIngreso" class="form-label fw-semibold">Fecha de Ingreso</label>
                        <input asp-for="FechaIngreso" type="date" class="form-control" required />
                        <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                    </div>

                    <!-- Estado por defecto -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="True" selected>Activo</option>
                            <option value="False">Inactivo</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Guardar Vendedor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>